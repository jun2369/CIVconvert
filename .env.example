# CIVconvert settings – names only. Put real values in the hosting platform's
# environment / secret settings (Northflank: Environment > Runtime variables), never in git.

# Database. Production: PostgreSQL (Northflank PostgreSQL addon -> connection string).
# Not set: local SQLite file data/civconvert.db (the Docker image refuses to start without it).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# (POSTGRES_URI is read too, the name a linked PostgreSQL addon usually has)

# Company Nimbus account system used for login (same as the HTS rule engine).
NIMBUS_API_URL=https://nimbusgroup.us

# Login accounts that do not go through Nimbus: a name and its password, a comma between two of them.
# Not set: the built-in TEST001 (see settings.local_logins). Setting this replaces it; setting it to
# nothing at all leaves no such account and only a Nimbus account can log in.
LOCAL_LOGINS=

# Machine access to the conversion API (Power Automate, scripts): X-API-Key header. Comma-separated = several keys.
API_KEY=

# How long a login lasts without being used (hours, default 168 = 7 days).
SESSION_TTL_HOURS=168

# Documents are deleted automatically this many months after upload (default 4; 0 = never).
DOCUMENT_RETENTION_MONTHS=4

# Original PDFs: db (default, inside the database) or local (files under LOCAL_FILE_DIR, e.g. a mounted volume).
FILE_STORAGE=db
LOCAL_FILE_DIR=

# Local development only: log in with just an e-mail address. Never set this in production.
AUTH_DEV_LOGIN=

# Optional: customer profiles / templates from a mounted folder instead of the image.
CIVCONVERT_CONFIG_DIR=

# OCR of pictures and scanned PDFs: CPU threads it uses (default 2; a container sees all the host's cores).
OCR_THREADS=
